# نمونه‌ی متغیرهای محیطی — این فایل را به .env کپی و مقادیر را پر کن
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*

# دیتابیس: sqlite (پیش‌فرض توسعه) یا postgres
DB_ENGINE=sqlite
# برای postgres مقادیر زیر را پر کن:
# DB_ENGINE=postgres
# DB_NAME=seo_platform
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# کلید Fernet برای رمزنگاری پسورد دسترسی‌ها (فاز پروژه‌ها)
FERNET_KEY=

# پنجشنبه کاری است؟ (پیش‌فرض: بله)
THURSDAY_IS_WORKDAY=True
