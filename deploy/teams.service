# نمونه‌ی سرویسِ systemd برای «Teams» (Gunicorn).
# کپی به: /etc/systemd/system/teams.service
# سپس:  sudo systemctl daemon-reload && sudo systemctl enable --now teams
[Unit]
Description=Teams (SEO Manager) - gunicorn
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/teams
# هومِ www-data روی اوبونتو /var/www است (غیرقابلِ‌نوشتن)؛ gunicorn فایلِ کنترلش را
# در $HOME/.gunicorn می‌سازد. HOME را به پوشه‌ی پروژه (مالکِ www-data) بده.
Environment=HOME=/var/www/teams
EnvironmentFile=/var/www/teams/.env
# systemd پوشه‌ی /run/teams را با مالکیتِ www-data می‌سازد (و موقعِ stop پاک می‌کند)
# تا سوکت آنجا ساخته شود؛ ساختنِ مستقیمِ فایل در /run برای www-data ممنوع است.
RuntimeDirectory=teams
ExecStart=/var/www/teams/.venv/bin/gunicorn config.wsgi:application \
    --workers 3 \
    --bind unix:/run/teams/teams.sock
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
