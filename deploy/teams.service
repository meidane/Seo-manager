# نمونه‌ی سرویسِ systemd برای «Teams» (Gunicorn).
# کپی به: /etc/systemd/system/teams.service
# سپس:  sudo systemctl daemon-reload && sudo systemctl enable --now teams
[Unit]
Description=Teams (SEO Manager) - gunicorn
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/teams
EnvironmentFile=/var/www/teams/.env
ExecStart=/var/www/teams/.venv/bin/gunicorn config.wsgi:application \
    --workers 3 \
    --bind unix:/run/teams.sock
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
