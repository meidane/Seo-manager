# نمونه‌ی .env تولیدیِ «Teams» — کپی به /var/www/teams/.env و مقادیر را پر کن.
# هیچ‌وقت .env واقعی را کامیت نکن (در .gitignore هست).

DEBUG=False
# python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-value

ALLOWED_HOSTS=teams.example.com
CSRF_TRUSTED_ORIGINS=https://teams.example.com

# کلیدِ پایدارِ رمزنگاریِ دسترسی‌ها (بدونِ آن از SECRET_KEY مشتق می‌شود).
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=

# ── PostgreSQL ──────────────────────────────────────────────
DB_ENGINE=postgres
DB_NAME=teams
DB_USER=teams
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
